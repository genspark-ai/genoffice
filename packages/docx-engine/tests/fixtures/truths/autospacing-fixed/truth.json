      "note": "auto 11pt -> auto 17pt collapse to one 14pt"
    },
    {
      "kind": "paraGapPt",
      "from": 2,
      "to": 3,
      "expect": 14,
      "tol": 0.001,
      "note": "auto 17pt -> plain"
    }
