{
  "_about": "Line factors of knownLineFactor() (apps/docs/src/renderer/line-metrics.ts), emitted to line-factors.generated.ts by tools/build-font-aliases.mjs. Rules run in order within their stage; stages interleave with the behavioural branches of knownLineFactor: first (before the CJK-class delegations), arabic (before the Arabic altName route), latin (after it), last (after the KR/hangul/ideograph routes). match/exclude are regex sources tested against the lower-cased declared name, or a ref to a pattern of font-name-patterns.ts. A pin keeps the table value over the resolver (LINE_FACTOR_PINS).",
  "rules": [
    {
      "id": "aptos",
      "stage": "first",
      "match": "aptos",
      "factor": 1.22,
      "source": {
        "kind": "probe",
        "date": "2026-08-22",
        "probe": "Word probe: Aptos (M365 cloud face) paces 1.22, same as Calibri"
      }
    },
