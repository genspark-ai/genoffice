{
  "name": "@genoffice/cli",
  "version": "0.6.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "genoffice: the GenOffice command line (create, convert, read, edit and render documents) built on the same engines as the app; runs headless on the app's bundled Node runtime",
  "exports": {
    ".": "./src/index.ts",
    "./install": "./src/install.ts"
  },
  "bin": {
    "genoffice": "./bin/genoffice"
  },
  "scripts": {
    "build": "node build.mjs && node collect-deps.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@genoffice/ai-provider": "*",
    "@genoffice/ai-search": "*",
    "@genoffice/docx-engine": "*",
    "@genoffice/pdf2docx": "*",
    "@genoffice/pipelines": "*",
    "@genoffice/pptx-engine": "*",
    "@genoffice/pptx-ops": "*",
    "@genoffice/pptx-render": "*",
    "@genoffice/xlsx-gateway": "*",
    "@tiptap/core": "3.31.0",
    "jsdom": "^28.0.0",
    "jszip": "^3.10.1",
    "numfmt": "^3.2.6",
    "undici": "^6.28.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
