{
  "name": "@genoffice/xls2xlsx",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "Legacy Excel 97-2003 import: parse .xls (OLE2/CFB + BIFF8) and rebuild it as .xlsx; staged as values foundation, then formatting/dates, then styles",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "cfb": "^1.2.2",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
