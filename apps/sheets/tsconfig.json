{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "vite/client"],
    // file-parse ships as TS source and its deps fail this package's stricter compiler options;
    // types go through a local shim (src/types/file-parse.d.ts) while the runtime bundle still uses the real source
    "paths": {
      "@genoffice/file-parse": ["./src/types/file-parse.d.ts"],
      "@genoffice/docx-engine/math": ["./src/types/docx-engine-math.d.ts"],
      // resolve workspace types from this checkout's sources: in a git worktree
      // node_modules is a symlink into the main checkout, so bare specifiers
      // would typecheck against the other checkout's (possibly stale) types
      "@genoffice/electron-utils": ["../../packages/electron-utils/src/index.ts"]
    }
  },
  "include": [
    "electron.vite.config.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "scripts/**/*.ts",
    "tests/**/*.ts"
  ]
}
